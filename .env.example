# Default: Gemini free tier (get a key at https://aistudio.google.com/apikey)
LLM_PROVIDER=gemini
LLM_MODEL=gemini-3.6-flash
# Tried in order if the main model is overloaded (503), rate-limited or times out
LLM_FALLBACK_MODELS=gemini-3.5-flash,gemini-3.8-flash,gemini-3.5-flash-lite
GEMINI_API_KEY=your-key-here

# Swap to any OpenAI-compatible model (OpenAI, Groq, OpenRouter, a provided API...):
# LLM_PROVIDER=openai_compatible
# LLM_MODEL=gpt-4o
# LLM_BASE_URL=https://api.openai.com/v1
# LLM_API_KEY=...

# Seconds between calls (free-tier rate limits). Set 0 for paid keys.
LLM_MIN_INTERVAL=6.5
